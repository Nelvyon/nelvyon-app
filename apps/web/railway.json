{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/web/Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["pnpm -C apps/web migrate:prod"],
    "healthcheckPath": "/api/health/live",
    "healthcheckTimeout": 120
  }
}
