# Root build context for Railway /Dockerfile (monorepo).
# Prevents host node_modules / huge artifacts from clobbering Linux deps on COPY . .
node_modules
**/node_modules
.git
.github
.next
**/.next
.turbo
**/.turbo
.release-logs
.cursor
.claude
frontend
docs
**/.env
**/.env.*
!**/.env.example
**/coverage
**/dist
**/*.log
backend/local-ai/benchmarks
backend/local-ai/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
# Local WIP API routes — keep out of image until tracked + typecheck-clean on main
apps/web/src/app/api/saas/mcp
apps/web/src/app/api/saas/orchestrator
