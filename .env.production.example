# NELVYON — Plantilla producción (Railway)
# Copiar nombres a Railway → @nelvyon/web y nelvyon-app. NO commitear valores reales.
# Fuente de verdad: docs/PRODUCTION_SECRETS.md

# ─── Obligatorias (Web) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.internal:5432/railway
JWT_SECRET=                          # openssl rand -hex 32 (≥32 chars)
CRON_SECRET=                         # openssl rand -hex 32 (≥16 chars)
NEXT_PUBLIC_APP_URL=https://nelvyon.com
NEXT_PUBLIC_API_BASE_URL=https://nelvyon-app-production.up.railway.app

# ─── Stripe (live) ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_ID_STARTER=price_
STRIPE_PRICE_ID_PRO=price_
STRIPE_PRICE_ID_AGENCY=price_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_

# ─── AWS SES (Web — nombres SES_*) ──────────────────────────────────────────
SES_REGION=eu-west-1
SES_ACCESS_KEY_ID=AKIA...
SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=no-reply@nelvyon.com

# ─── Redis / rate limit ───────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── Recomendadas ─────────────────────────────────────────────────────────────
TRACKING_SECRET=                       # openssl rand -hex 32
OPENAI_API_KEY=sk-
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=                # mismo DSN público que SENTRY_DSN
OAUTH_ENCRYPTION_KEY=
API_KEYS_ENCRYPTION_SECRET=

# ─── FastAPI (nelvyon-app) ───────────────────────────────────────────────────
ENVIRONMENT=production
JWT_SECRET_KEY=                        # mismo valor que JWT_SECRET
REDIS_URL=redis://...
FRONTEND_APP_URL=https://nelvyon.com
AWS_ACCESS_KEY_ID=                     # mismas credenciales IAM que SES_*
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# ─── Opcionales ───────────────────────────────────────────────────────────────
STRIPE_PRICE_ID_AGENCY_PARTNER=price_
AUTONOMOUS_PRODUCTION=true
SUPABASE_URL=                          # solo si portal deliverables con storage real
SUPABASE_SERVICE_ROLE_KEY=

# ─── NO usar (legacy) ───────────────────────────────────────────────────────
# STRIPE_PUBLISHABLE_KEY, SUPABASE_ANON_KEY, PADDLE_*, NEXTAUTH_* (sin uso activo)
